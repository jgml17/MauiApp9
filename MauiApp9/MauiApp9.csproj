<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
<!--        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>-->
        <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
        <!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

        <!-- Note for MacCatalyst:
        The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
        When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
        The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
        either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <!-- AOT  -->
        <RunAOTCompilation>false</RunAOTCompilation>

        <LangVersion>preview</LangVersion>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <OutputType>Exe</OutputType>
        <RootNamespace>MauiApp9</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>MauiApp10</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.mauiapp9</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185"/>

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- Development Configuration for iOS -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
<!--        <CodesignKey>Apple Development: Jose Machado (4G5N29NA33)</CodesignKey>-->
<!--        <CodesignProvision>DevJustSendIt</CodesignProvision>-->
<!--        <CodesignEntitlements>Platforms/iOS/Entitlements.dev.plist</CodesignEntitlements>-->
        <DefineConstants>IOS</DefineConstants>
        <MtouchLink>None</MtouchLink>
        <MtouchDebug>true</MtouchDebug>
        <MtouchProfiling>true</MtouchProfiling>
        <MtouchFastDev>true</MtouchFastDev>
        <MtouchUseLlvm>false</MtouchUseLlvm>
        <OptimizeForSize>false</OptimizeForSize>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
        <AndroidEnableProfiler>true</AndroidEnableProfiler>
        <AndroidSupportedAbis>armeabi-v7a;arm64-v8a</AndroidSupportedAbis>
        <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
        <AndroidDexTool>d8</AndroidDexTool>
        <AndroidLinkTool>r8</AndroidLinkTool>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>
        <RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="AdamE.MemoryToolkit.Maui" Version="1.0.0" />
        <PackageReference Include="CommunityToolkit.Maui" Version="14.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
<!--        <PackageReference Include="Emgu.CV.runtime.maui.mini" Version="4.10.0.5680" />-->
        <PackageReference Include="ImageCropper.Maui" Version="1.2.4" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.31" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.31" />
        <PackageReference Include="Mopups" Version="1.3.4" />
        <PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />
        <PackageReference Include="Plugin.Toolkit.Fonts.MaterialIcons" Version="1.0.4" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.8" />
        <PackageReference Include="UXDivers.Popups.Maui" Version="0.9.1" />
    </ItemGroup>
    
    <ItemGroup>
      <MauiXaml Remove="MessagePage.xaml" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Remove="MessagePage.xaml.cs" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="../MauiApp9.Plugin.Contracts/MauiApp9.Plugin.Contracts.csproj" />
      <ProjectReference Include="..\MauiAppCore\MauiAppCore.csproj" />
    </ItemGroup>

</Project>
