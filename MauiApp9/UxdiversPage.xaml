<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiApp9.UxdiversPage"
    x:DataType="viewModel:UxdiversViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModel="clr-namespace:MauiAppCore;assembly=MauiAppCore"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        RowDefinitions="Auto, Auto"
        RowSpacing="20"
        VerticalOptions="Center">

        <Button
            Grid.Row="0"
            HorizontalOptions="Center"
            Text="Call Popup Sheet">
            <Button.Behaviors>
                <toolkit:TouchBehavior
                    DefaultAnimationDuration="50"
                    DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
                    PressedOpacity="0.6"
                    PressedScale="0.9"
                    TouchGestureCompleted="TouchBehavior_OnTouchGestureCompleted" />
            </Button.Behaviors>
        </Button>

        <Entry
            Grid.Row="1"
            HorizontalOptions="Center"
            Text="{Binding Status}"
            VerticalOptions="Fill" />
    </Grid>
</ContentPage>