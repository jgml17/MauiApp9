<?xml version="1.0" encoding="utf-8" ?>

<uxdc:ActionModalPopup
    ActionButtonCommand="{Binding ActionButtonCommand}"
    ActionButtonText="Ok"
    BindingContext="{x:Reference Popup}"
    ShowActionButton="True"
    Title="Test UXDivers Popup"
    x:Class="MauiApp9.Popups.UxDiversPopup"
    x:Name="Popup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:uxdc="clr-namespace:UXDivers.Popups.Maui.Controls;assembly=UXDivers.Popups.Maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout HeightRequest="400" WidthRequest="400">
        <Image Aspect="AspectFit" Source="dotnet_bot.png" />

        <Entry Text="{Binding Entry}" />
    </VerticalStackLayout>


</uxdc:ActionModalPopup>